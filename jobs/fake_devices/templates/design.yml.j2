locations:
{% for hostname, device in devices.items() %}
  - name: "{{ device.region }}"
    location_type__name: "Region"

  - name: "{{ device.country }}"
    location_type__name: "Country"
    parent:
      name: "{{ device.region }}"

  - name: "{{ device.state }}"
    location_type__name: "State/Province"
    parent:
      name: "{{ device.country }}"

  - name: "{{ device.site }}"
    location_type__name: "Site"
    parent:
      name: "{{ device.state }}"
{% endfor %}

devices:
{% for hostname, ip in devices %}
  - name: "{{ hostname }}"
    location:
      name: "{{ device.site }}"
    device_type:
      "!get:model": "33609"
    role:
      name: "compressor"
    status:
      "!get:name": "Active"
    primary_ip4: "!ref:{{ hostname }}_ip"
    interfaces:
      - name: "GigabitEthernet0/0"
        type: "1000base-t"
        status:
          "!get:name": "Active"
        ip_addresses:
          - address: "{{ ip }}"
            status:
              "!get:name": "Active"
            "!ref": "{{ hostname }}_ip"
{% endfor %}
