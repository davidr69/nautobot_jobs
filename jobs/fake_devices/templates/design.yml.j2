devices:
{% for device in devices %}
  - model: dcim.device
    attributes:
    name: "{{ device.hostname }}"
    location:
      "name": "{{ device.site }}"
    device_type:
      "model": "33609"
    role:
      "name": "compressor"
    status:
      "name": "Active"
    interfaces:
      - name: "GigabitEthernet0/0"
        type: "1000base-t"
        status:
          "!get:name": "Active"
        ip_addresses:
          - address: "{{ device.ip }}"
            status:
              "!get:name": "Active"
{% endfor %}
