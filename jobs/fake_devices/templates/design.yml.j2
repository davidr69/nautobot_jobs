roles:
  - "!create_or_update:name": "compressor"
    "!ref": "compressor_role"

devices:
{% for device in devices %}
  - name: "{{ device.hostname }}"
    location:
      "!get:name": "{{ device.site }}"
    device_type:
      "!get:model": "33609"
    role: "!ref:compressor_role"
    status:
      "!get:name": "Active"
    interfaces:
      - name: "GigabitEthernet0/0"
        type: "1000base-t"
        status:
          "!get:name": "Active"
        ip_addresses:
          - address: "{{ device.ip }}"
            status:
              "!get:name": "Active"
{% endfor %}
