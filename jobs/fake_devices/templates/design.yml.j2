dcim.device:
{% for device in devices %}
  - attributes:
      name: "{{ device.hostname }}"
      location:
        "name": "{{ device.site }}"
      device_type:
        "model": "33609"
      role:
        "name": "compressor"
      status:
        "name": "Active"
{% endfor %}

dcim.interface:
{% for device in devices %}
  - attributes:
      device:
        "name": "{{ device.hostname }}"
      name: "GigabitEthernet0/0"
      type: "1000base-t"
      status:
        "name": "Active"
{% endfor %}

ipam.ip_address:
{% for device in devices %}
  - attributes:
      address: "{{ device.ip }}"
      status:
        "name": "Active"
      assigned_object_type: "dcim.interface"
      assigned_object:
        name: "GigabitEthernet0/0"
        device:
          name: "{{ device.hostname }}"
{% endfor %}
