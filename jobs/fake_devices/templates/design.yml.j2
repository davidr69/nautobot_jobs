locations:
  - name: "{{ site_name }}"
    status:
      "!get:name": "Active"
    location_type:
      name: "Site"
    devices:
      {% for hostname, ip in device_ips.items() %}
      - name: "{{ hostname }}"
        device_type:
          model: "33609"
        role:
          name: "compressor"
        status:
          "!get:name": "Active"
        primary_ip4: "!ref:{{ hostname }}_ip"
        interfaces:
          - name: "GigabitEthernet0/0"
            type: "1000base-t"
            status:
              "!get:name": "Active"
            ip_addresses:
              - address: "{{ ip }}"
                status:
                  "!get:name": "Active"
                "!ref": "{{ hostname }}_ip"
      {% endfor %}
